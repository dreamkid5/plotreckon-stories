# PlotReckon Stories worker environment.
# Copy this file to .env in the worker folder, fill in what you use, then run:
#   npm run now      start immediately and keep rendering as you drop scripts
#   npm run once     process the current batch once and exit
# With no keys, videos still render with motion and music, just no narration.

# ----- Voice: Ava, female Storytime narrator (FREE, no key, locked) -----
# Microsoft Edge's free neural voices.
# Install once:  pip install edge-tts   (see SETUP-VOICE.md)
CF_TTS_PROVIDER=edge
# Production always uses Ava and a female presenter. These values document the
# lock; changing them does not override worker/voice.mjs.
CF_EDGE_VOICE=en-US-AvaMultilingualNeural
CF_EDGE_RATE=+0%
CF_EDGE_PITCH=+0Hz

# ----- Alternative voices (optional, all cost money or need a key) -----
# Microsoft Azure (needs key + card, 500k/mo free): AZURE_SPEECH_KEY=, AZURE_SPEECH_REGION=eastus, CF_TTS_PROVIDER=azure, CF_AZURE_VOICE=en-US-BrianNeural
# ElevenLabs (top realism, tiny free tier):        ELEVENLABS_API_KEY=, CF_ELEVEN_VOICE=VR6AewLTigWG4xSOukaG
# Local Piper server (British/US, not Nigerian):   LOCAL_TTS_URL=http://localhost:5111

# ----- Rendering -----
# folktale3d = 3D animated African folktale look (matches the reference character).
CF_STYLE=engraving
# Production is locked to exactly 5.5 seconds per scene. This value documents
# the contract; worker/render.mjs ignores attempts to override it.
CF_SCENE_SECONDS=5.5
CF_INTERVAL=60
# Quality: output resolution and x264 quality (lower CRF = sharper, bigger files).
# 1080p by default. Drop to 1280x720 to render very long videos faster.
CF_WIDTH=1920
CF_HEIGHT=1080
CF_CRF=20

# ----- Image reliability vs quality/speed (the free image service throttles under load) -----
# Fewer parallel image requests = fewer "busy" failures, but slower. 2-3 is a good balance.
CF_IMG_CONCURRENCY=3
# Prompt enhancement: nicer first try, slightly more likely to fail. Set to 0 to disable.
CF_IMAGE_ENHANCE=1
# If you still see failures on a big video, the most reliable setup is 720p:
#   CF_WIDTH=1280  CF_HEIGHT=720  (the service almost never refuses these)
# A free Pollinations token also raises your limits — get one at https://enter.pollinations.ai
# CF_IMAGE_TOKEN=

# Claude API key powers SEO, character consistency, and scene matching.
ANTHROPIC_API_KEY=
CF_SEO_MODEL=claude-haiku-4-5-20251001

# ----- YouTube auto upload, optional -----
# YT_CLIENT_ID=
# YT_CLIENT_SECRET=
# YT_REFRESH_TOKEN=
# CF_YT_PRIVACY=unlisted
